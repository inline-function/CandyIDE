<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- 外部文件访问（设置页可开启）：不声明则系统设置页里该开关为灰色且无法打开 -->
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE" tools:ignore="ScopedStorage" />
    <!-- 安卓 10 及以下：普通读写存储权限（MANAGE_EXTERNAL_STORAGE 从 11 才有） -->
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" android:maxSdkVersion="29" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" android:maxSdkVersion="29" />
    <!-- AI agent 联网（OpenAI 兼容端点） -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- 明文流量：私有部署/自建端点可能无 TLS，允许 http（https 默认可用） -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Termux RUN_COMMAND：没有 Shizuku 时把命令交给 Termux 执行（dangerous 级，需用户授权） -->
    <uses-permission android:name="com.termux.permission.RUN_COMMAND" />
    <!-- 无障碍服务：留给 agent 后续操作 IDE 界面（系统级签名权限，需用户在系统设置手动开启） -->
    <uses-permission android:name="android.permission.BIND_ACCESSIBILITY_SERVICE" />

    <!-- Android 11+ 包可见性：查询伴生软件是否安装 -->
    <queries>
        <package android:name="com.termux" />
        <package android:name="moe.shizuku.privileged.api" />
    </queries>


    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.CandyIDE">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- 接收外部发来的 jks/caco/capr 文件 -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="*/*" />
                <data android:pathPattern=".*\.jks" />
                <data android:pathPattern=".*\.caco" />
                <data android:pathPattern=".*\.capr" />
            </intent-filter>
        </activity>

        <!-- Shizuku 服务句柄投递入口：Shizuku/Sui 通过该 provider 把 binder 推给本应用 -->
        <!-- 无障碍服务：留给 agent 操作 IDE 界面（系统设置手动开启，清单声明占位） -->
        <service
            android:name=".agent.CandyAccessibilityService"
            android:exported="false"
            android:label="CandyIDE Agent"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
        </service>
        <provider
            android:name="rikka.shizuku.ShizukuProvider"
            android:authorities="${applicationId}.shizuku"
            android:multiprocess="false"
            android:enabled="true"
            android:exported="true"
            android:permission="android.permission.INTERACT_ACROSS_USERS_FULL" />
            <!-- 以其它应用打开工程文件（FileProvider 临时读授权） -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>

</manifest>
