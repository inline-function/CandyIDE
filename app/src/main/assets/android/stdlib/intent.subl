// android/intent.subl —— 意图（android doc/安卓标准库.md §意图）
//
// 安卓特有能力：跳出本应用、驱动其它应用与系统页面。全部无返回值（Unit=Null），
// 失败时 KT 端弹 toast 提示。

@android @impure fun openUrl(url: Str): Null
@android @impure fun shareText(text: Str): Null
@android @impure fun dial(phone: Str): Null
@android @impure fun sms(phone: Str): Null
@android @impure fun openSettings(): Null
@android @impure fun launchApp(packageName: Str): Null
