// core.math.order —— 序理论定理族（≤ / < 的结构性质与单调性）
// 依赖：无新增（与 math.subl 并列同模块；core.logic 挂载本包后用户侧可见）。
//
// 【形态选型依据（实测，当前构建）】
//  · 后件为原子/布尔组合、项为 NameRef 或 IntLit 的形态：**可被定理搜索直接命中**
//    （全序/三歧/反自反属此类——线性算术通道证不了双变量析取目标，这两条是本族最大增益）；
//  · 项含 BinExpr（a + c、a * b 等）的形态：搜索不可靠（toString 兜底），须**调用注入**
//    （`mono add`<x, y, k>() 等已验证）；
//  · 结论为等式的蕴含（消去律类）：自动通道与饱和 MP 对等式结论支撑弱——以**整形目标**或
//    调用注入事实使用，详见各条注释。
// 【P-3 自审】与 core.logic/core.classic/core.zfc 及 core.math 既有声明逐一比对：
//  logic 有 leq refl / leq trans（≤ 头）；本族一律 < 头或 ≤ 的全序/三歧/混合链形态，
//  与 logic 零重叠；math.subl 全为值级函数，无 @theorem。

// 【调用注入的两条硬规则（实测）】
//  ① 调用尖括号里的**项级参数必须用变量名**（`mono mul`<x, y, k>()），传字面量
//    （`cong trans`<x, y, k, 3>()）不参与实例化——注入的后件里 m 保持自由，MP 不触发；
//  ② 调用注入的定理后件与目标须**结构同一**（变量名、括号完全一致）——命题层不做
//    算术求值，形态靠匹配。

// ---------- 全序与三歧（搜索命中主力：无前提的双变量析取目标） ----------

// 全序：任意两数可比较。目标 ∴ (x <= y) ∨ (y <= x) 直接命中。
// 用途：穷尽性目标（when 穷尽、排序讨论）、不可比较假设的反驳。
@theorem
fun `le total`[a, b]: Null <(a <= b) ∨ (b <= a)>

// 三歧律：<、=、> 恰居其一。目标 ∴ (x < y) ∨ (x = y) ∨ (y < x) 直接命中。
// 用途：分类讨论穷尽、严格序与相等的分情况证明。
@theorem
fun `lt trichotomy`[a, b]: Null <(a < b) ∨ (a = b) ∨ (b < a)>

// ---------- 严格序性质 ----------

// 反自反：x < x 恒假。目标 ∴ ¬(x < x) 直接命中。
// 用途：排除严格自比、循环比较的反驳。
@theorem
fun `lt irrefl`[a]: Null <¬(a < a)>

// 严格序传递：两段 < 接成一段。
// 用途：链式比较目标的整形（通道对线性 < 已自动可证；此条留作 ∴ 整形与记录）。
@theorem
fun `lt trans`[a, b, c]: Null <((a < b) & (b < c)) → (a < c)>

// 混合传递（≤ 接 <）：非严格接严格得严格。
// 用途：≤/< 混写链条（如排序不变量 x <= y & y < z ⟹ x < z）。
@theorem
fun `le lt trans`[a, b, c]: Null <((a <= b) & (b < c)) → (a < c)>

// 混合传递（< 接 ≤）。
@theorem
fun `lt le trans`[a, b, c]: Null <((a < b) & (b <= c)) → (a < c)>

// 反对称（≤ 版）：互 ≤ 即相等。
// 用途：证相等目标的双向夹逼收口（a <= b & b <= a ⟹ a = b）。
@theorem
fun `le antisym`[a, b]: Null <((a <= b) & (b <= a)) → (a = b)>

// ---------- 单调性（项含 BinExpr：调用注入形态） ----------

// 加法保序：a <= b ⟹ a + c <= b + c。
// 用法：axiom (x <= y) → `mono add`<x, y, k>() → ∴ (x + k) <= (y + k)。
// （线性通道对本形已自动可证；本条作注入兜底与形态记录。）
@theorem
fun `mono add`[a, b, c]: Null <(a <= b) → ((a + c) <= (b + c))>

// 加法严格保序：a < b ⟹ a + c < b + c。
@theorem
fun `mono strict add`[a, b, c]: Null <(a < b) → ((a + c) < (b + c))>

// 乘法保序（非线性：通道做不了）：a <= b ⟹ a * c <= b * c。
// 用法：axiom (x <= y) → `mono mul`<x, y, k>() → ∴ (x * k) <= (y * k)。
// 非线性算术（变量系数乘积）不在线性通道片段内——本条是唯一自动路径。
@theorem
fun `mono mul`[a, b, c]: Null <(a <= b) → ((a * c) <= (b * c))>

// 乘法严格保序（须 c ≠ 0，由使用者保证）：a < b 与 0 < c ⟹ a * c < b * c。
@theorem
fun `mono strict mul`[a, b, c]: Null <((a < b) & (0 < c)) → ((a * c) < (b * c))>
