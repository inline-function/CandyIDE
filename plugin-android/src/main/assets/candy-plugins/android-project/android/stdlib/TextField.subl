// android/TextField.subl —— 文本输入视图（android doc/安卓标准库.md §布局）
//
// onChange 在每次内容变化时回调 JS（参数为当前文本）。注意：推荐 onChange 只更新
// JS 侧状态、不触发视图重组——重组会重建输入框并丢失焦点/光标；提交时再由按钮
// 等控件读取已保存的状态。

@view struct TextField(
    placeholder: Str = "",
    text: Str = "",
    keyboard: Str = "text",
    onChange: @impure (Str) => Null = fun(t: Str): Null { null },
    modifier: Modifier = Plain(),
    body: () => Null = fun(): Null { null }
)
