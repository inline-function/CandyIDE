// android/activity.subl —— 活动生命周期（android doc/安卓标准库.md §活动）
//
// 应用仅由一个活动构成。JS 端通过注册函数声明各生命周期行为；KT 端在事件发生时
// 经 webview 桥回调。注册函数由 @android 内建实现（编译器桥接到 __dshAndroid，
// 由宿主登记回调），脚本端不提供函数体。
//
// body 形参是单参 lambda：`onCreate { log(x) }` 的尾随 lambda 脱糖为 (\_) => …。

@android @impure fun onCreate(body: @impure (Any) => Null): Null
@android @impure fun onStart(body: @impure (Any) => Null): Null
@android @impure fun onPause(body: @impure (Any) => Null): Null
@android @impure fun onStop(body: @impure (Any) => Null): Null
@android @impure fun onResume(body: @impure (Any) => Null): Null
@android @impure fun onDestroy(body: @impure (Any) => Null): Null
@android @impure fun onRestart(body: @impure (Any) => Null): Null
