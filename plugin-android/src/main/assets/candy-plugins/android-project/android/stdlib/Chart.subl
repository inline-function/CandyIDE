// android/Chart.subl —— 图表视图（vico 风格，自绘实现）
//
// kind="line" 折线图（带数据点与渐变填充）；kind="bar" 柱状图。
// points 为 y 值序列，labels 为横轴刻度（可空）。color 形如 "#RRGGBB"。
@view struct Chart(
    points: List[Rat] = emptyList(),
    labels: List[Str] = emptyList(),
    kind: Str = "line",
    color: Str = "",
    modifier: Modifier = Plain(),
    body: () => Null = fun(): Null { null }
)