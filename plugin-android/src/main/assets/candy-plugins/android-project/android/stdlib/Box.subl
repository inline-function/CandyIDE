// android/Box.subl —— 布局容器（android doc/安卓标准库.md §布局）
//
// @view 视图结构体：body 参数承载子视图——编译后擦除 body、子视图成为 children 成员。
// recomposion 属性由 @view 处理器注入：视图被修改时带上修改后的副本回调 KT 端。
// orientation 为 "vertical"（默认）或 "horizontal"；backgroundColor 为 "#RRGGBB"。

@view struct Box(
    modifier: Modifier = Plain(),
    contentAlignment: Alignment = Center(),
    orientation: Str = "vertical",
    backgroundColor: Str = "",
    body: () => Null = fun(): Null { null }
)
