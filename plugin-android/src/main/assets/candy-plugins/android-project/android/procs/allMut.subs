// @allMut —— 标在结构体上：结构体可变，且其全部字段可变

// 等价于把 @allMut struct P(x: Nat) 变成 @mut struct P(@mut x: Nat)
fun processStructs(xs: List[Str]): Null = when(xs) {
    Nil => null
    is Cons(s, rest) => {
        addStructAnnotation(s, "mut")
        processFields(s, structFields(s))
        processStructs(rest)
    }
}
fun processFields(st: Str, xs: List[Str]): Null = when(xs) {
    Nil => null
    is Cons(f, rest) => {
        addFieldAnnotation(st, f, "mut")
        processFields(st, rest)
    }
}
processStructs(structsWithAnnotation("allMut"))

